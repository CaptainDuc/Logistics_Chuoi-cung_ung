## Combined gitignore for frontend + backend

# Node modules
node_modules/
/frontend/node_modules/
/backend/node_modules/

# Build outputs
.next/
out/
build/
dist/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS junk
.DS_Store
Thumbs.db

# Coverage and reports
coverage
*.lcov
.nyc_output

# Misc caches
.npm
.eslintcache
.stylelintcache
.node_repl_history
.cache
.parcel-cache

# Other common ignores
.vscode-test
.pnpm-store
.pnp.*
.yarn/

# Allow example env
!.env.example

