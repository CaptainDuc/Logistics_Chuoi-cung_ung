# Các thư mục chứa thư viện tải về (Cực kỳ nặng, tuyệt đối không đẩy lên Git)
node_modules/
/frontend/node_modules/
/backend/node_modules/

# Thư mục build và rác sản sinh khi chạy Next.js
.next/
out/
build/
dist/

# Các file cấu hình biến môi trường chứa token bảo mật, chuỗi kết nối DB (Yêu cầu bắt buộc)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# File log hệ thống khi xảy ra lỗi
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# File rác của hệ điều hành
.DS_Store
Thumbs.db