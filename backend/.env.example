# MongoDB Atlas connection string
# Ví dụ:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=

# JWT secrets
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-refresh-jwt-secret

# Email settings (Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password
ADMIN_EMAIL=admin@example.com

# CORS origin cho Frontend Vercel / local dev
# Có thể để * trong môi trường thử nghiệm, nhưng nên chỉ định domain Vercel khi deploy.
CORS_ORIGIN=http://localhost:3000

# Port dành cho backend service
PORT=4000
